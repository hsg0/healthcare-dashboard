# WHAT — Lists the database settings this API expects.
# WHY — Another person can see the names without seeing your real password.
# HOW — Copy this file to .env and paste the values from the Supabase dashboard.
# IMPORTANT — .env is secret. Do not commit it. Use the Supabase pooler host, not the direct db.* host.

DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# You can set this instead of the DB_* values above.
# Keep the postgresql:// prefix. The app switches it to the asyncpg driver.
# DATABASE_URL=postgresql://postgres.your_project_ref:your_database_password@aws-0-your-region.pooler.supabase.com:5432/postgres
